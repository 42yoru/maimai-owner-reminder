{
  "manifest_version": 2,
  "version": "0.1.0",
  "name": "主人的叮嘱 (Owner Reminder)",
  "description": "主人在任意聊天流下达一条短期叮嘱，作用于指定的另一个聊天流：以强/弱两档影响她的 planner，到期自动淡出。纯插件实现，不改主程序。",
  "author": {
    "name": "YeYe",
    "url": "https://github.com/42yoru"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/42yoru/yeye_owner_reminder",
    "homepage": "https://github.com/42yoru/yeye_owner_reminder",
    "documentation": "https://github.com/42yoru/yeye_owner_reminder/blob/main/README.md",
    "issues": "https://github.com/42yoru/yeye_owner_reminder/issues"
  },
  "host_application": {
    "min_version": "1.3.9",
    "max_version": "1.3.99"
  },
  "sdk": {
    "min_version": "2.14.0",
    "max_version": "2.99.99"
  },
  "dependencies": [],
  "capabilities": [
    "chat.get_group_streams",
    "chat.get_private_streams",
    "send.text",
    "maisaka.proactive.trigger"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  },
  "id": "yeye.owner-reminder"
}
